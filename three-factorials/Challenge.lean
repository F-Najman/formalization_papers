/-!
# Products of three factorials: statements

Results of A. Dujella, F. Najman, N. Saradha, T. N. Shorey, *Products of three factorials*, Publ. Math. Debrecen 85
(2014), 123–130. Generated by `scripts/make_challenge.py`: the definitions the statements use, copied verbatim from
the library, then the statements with `sorry` proofs. `Solution a n`: a!(a − 3)!n! = y² with a − 3 > n > 1.

* Theorem 1.1 at a₃ = 26, unconditional: `case26_iff`, with `solution324_26`, `solution2738_26`, the steps
  `solution_iff_squarefree`, `solution26_remaining`, `quartic104006_no_solution`, `unique_first_system`,
  `unique_second_system`; alternative routes with a premise: `case26_iff_of_integral_points` (table checked by
  `integralPoints26_sound`) and `case26_iff_of_bennett`.
* Theorem 1.1: the listed pairs are solutions (`solutionsUpTo100_sound`); `theorem11_iff_of_completeness` assumes
  the completeness of the list.
* Theorem 1.2: (a) `theorem12a`; (b) changed: `theorem12b_fraction`, `theorem12b_odd`; (c) for a₃ ≥ 101
  `theorem12c_large`, `interval_card_ge_eleven`; with exceptions, assuming 1.1: `theorem12c_of_classification`.
* Checks against the paper: `prime_support_counterexample`, `auxiliary_quartic_six` (see README.md).
-/

@[expose] public section

namespace ThreeFactorials

/-- The three factors left after removing the square of `(a-3)!`. -/
def block (a : ℕ) : ℕ := a * (a - 1) * (a - 2)

/-- The equation with strictly decreasing indices `a > a-3 > n > 1`. -/
def Solution (a n : ℕ) : Prop :=
  1 < n ∧ n + 3 < a ∧ IsSquare (a.factorial * (a - 3).factorial * n.factorial)

/-- The integral-point equation for the congruent-number curve of parameter `d`. -/
def CongruentPoint (d : ℕ) (x y : ℤ) : Prop :=
  y ^ 2 = x ^ 3 - (d : ℤ) ^ 2 * x

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Finset

/-- The primes in the half interval (n/2,n]. -/
def intervalPrimes (n : ℕ) : Finset ℕ :=
  n.primesLE.filter fun p => n / 2 < p

/-- The ceiling of one third of the number of primes in the half interval. -/
def exponent (n : ℕ) : ℕ :=
  ((intervalPrimes n).card + 2) / 3

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials

/-- The review's integral-point table for `Y² = X³ − 104006² X`, with nonnegative ordinates. -/
def integralPoints26 : List (ℤ × ℕ) :=
  [(-104006, 0), (-102850, 4959240), (-51842, 20529432), (-49419, 20344155),
    (-322, 1866312), (-38, 641136), (0, 0), (104006, 0), (104652, 3755844),
    (208658, 82628568), (18610956, 80287186980), (33593938, 194710464648),
    (284664422, 4802858127984)]

/-- The unbounded assertion needed about the integral-point table. -/
def IntegralPoints26Complete : Prop :=
  ∀ x y : ℤ, CongruentPoint 104006 x y → (x, y.natAbs) ∈ integralPoints26

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials

def solutionsUpTo100 : List (ℕ × ℕ) :=
  [(10, 6), (50, 3), (50, 4), (324, 26), (352, 13), (442, 18), (2738, 26)]

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Finset

/-- The four forms in part (c), with the published constants. -/
inductive ForbiddenForm : ℕ → Prop
  | prime {α p : ℕ} (hp : p.Prime) (hα : α ≤ 64393) : ForbiddenForm (α * p)
  | cube {α p : ℕ} (hp : p.Prime) (hα : α ≤ 6) : ForbiddenForm (α * p ^ 3)
  | pair {α p q : ℕ} (hp : p.Prime) (hq : q.Prime) (hne : p ≠ q) (hα : α ≤ 637) :
      ForbiddenForm (α * (p * q))
  | triple {α p q r : ℕ} (hp : p.Prime) (hq : q.Prime) (hr : r.Prime)
      (hpq : p ≠ q) (hpr : p ≠ r) (hqr : q ≠ r) (hα : α ≤ 6) :
      ForbiddenForm (α * (p * q * r))

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Pell

/-- The first-coordinate uniqueness in Bennett's theorem on consecutive square multiples. -/
def BennettConsecutiveUnique : Prop :=
  ∀ A B C x y z u v w : ℕ,
    0 < A → 0 < B → 0 < C →
    0 < x → 0 < y → 0 < z → 0 < u → 0 < v → 0 < w →
    A * x ^ 2 = B * y ^ 2 + 1 → B * y ^ 2 = C * z ^ 2 + 1 →
    A * u ^ 2 = B * v ^ 2 + 1 → B * v ^ 2 = C * w ^ 2 + 1 →
    x = u

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials

theorem solution_iff_squarefree {a n d k : ℕ}
    (hn : n.factorial = d * k ^ 2) (hd : Squarefree d) (hk : 0 < k) :
    Solution a n ↔ 1 < n ∧ n + 3 < a ∧ ∃ t : ℕ, block a = d * t ^ 2 := sorry

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials

theorem solution324_26 : Solution 324 26 := sorry

theorem solution2738_26 : Solution 2738 26 := sorry

/-- Lean checks the curve equation at every entry in the reviewed table. -/
theorem integralPoints26_sound :
    ∀ p ∈ integralPoints26, CongruentPoint 104006 p.1 p.2 := sorry

/-- The reviewed integral-point completeness assertion implies precisely the desired two cases. -/
theorem case26_iff_of_integral_points (complete : IntegralPoints26Complete) (a : ℕ) :
    Solution a 26 ↔ a = 324 ∨ a = 2738 := sorry

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Pell

/-- The positive-ordinate quartic Pell equation needed for n = 26 has no solution. -/
theorem quartic104006_no_solution {y w : ℕ} (hw : 0 < w) :
    y ^ 4 ≠ 104006 * w ^ 2 + 1 := sorry

/-- Only the two squarefree systems with known solutions can occur at n = 26. -/
theorem solution26_remaining {a : ℕ} (h : Solution a 26) :
    ∃ x y z : ℕ, 0 < x ∧ 0 < y ∧ 0 < z ∧
      ((a = x ^ 2 ∧ a - 1 = 323 * y ^ 2 ∧ a - 2 = 322 * z ^ 2) ∨
       (a = 2 * x ^ 2 ∧ a - 1 = 2737 * y ^ 2 ∧ a - 2 = 19 * z ^ 2)) := sorry

/-- An alternative to the integral-point route, using Bennett's uniqueness theorem. -/
theorem case26_iff_of_bennett (unique : BennettConsecutiveUnique)
    (a : ℕ) : Solution a 26 ↔ a = 324 ∨ a = 2738 := sorry

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Finset

/-- The first squarefree system has exactly one positive solution. -/
theorem unique_first_system {x y z : ℕ} (hy : 0 < y)
    (hx : x ^ 2 = 323 * y ^ 2 + 1) (hz : 322 * z ^ 2 + 1 = 323 * y ^ 2) :
    x = 18 ∧ y = 1 ∧ z = 1 := sorry

/-- The second squarefree system has exactly one positive solution. -/
theorem unique_second_system {x y z : ℕ} (hy : 0 < y)
    (hx : 2 * x ^ 2 = 2737 * y ^ 2 + 1) (hz : 19 * z ^ 2 + 1 = 2737 * y ^ 2) :
    x = 37 ∧ y = 1 ∧ z = 12 := sorry

/-- The classification for (a_3=26) in Theorem 1.1, with no size restriction. -/
theorem case26_iff (a : ℕ) : Solution a 26 ↔ a = 324 ∨ a = 2738 := sorry

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials

theorem solutionsUpTo100_sound {a n : ℕ} (h : (a, n) ∈ solutionsUpTo100) :
    n ≤ 100 ∧ Solution a n := sorry

/-- The finite list gives Theorem 1.1 when its completeness has been established. -/
theorem theorem11_iff_of_completeness
    (complete : ∀ a n : ℕ, n ≤ 100 → Solution a n → (a, n) ∈ solutionsUpTo100)
    (a n : ℕ) : (n ≤ 100 ∧ Solution a n) ↔ (a, n) ∈ solutionsUpTo100 := sorry

/-- The published proof's prime-support assertion fails at a genuine solution. -/
theorem prime_support_counterexample :
    Solution 2738 26 ∧ Nat.Prime 37 ∧ 26 < 37 ∧ 2738 = 2 * 37 ^ 2 := sorry

/-- The auxiliary quartic has a positive solution at n = 6. -/
theorem auxiliary_quartic_six :
    (6 : ℕ).factorial = 5 * 12 ^ 2 ∧ Squarefree (5 : ℕ) ∧ (3 : ℕ) ^ 4 = 5 * 4 ^ 2 + 1 := sorry

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Finset

/-- Theorem 1.2(a). -/
theorem theorem12a {a n : ℕ} (h : Solution a n) :
    ((n : ℚ) / 2) ^ exponent n < a := sorry

/-- The corrected part (b) in the paper's fractional form. -/
theorem theorem12b_fraction {a n N α : ℕ} {factors : List ℕ}
    (h : Solution a n) (hN : N = a ∨ N = a - 1 ∨ N = a - 2)
    (he : N = α * factors.prod) (hs : ∀ p ∈ factors, p ≤ n)
    (hr : factors.length ≤ exponent n) :
    (n : ℚ) ^ (exponent n - factors.length) / 2 ^ exponent n -
      2 / (n : ℚ) ^ factors.length < α := sorry

/-- The review's second sufficient hypothesis for part (b), given directly in terms
of the selected primes' actual exponents in N. -/
theorem theorem12b_odd {a n N α : ℕ} {factors : List ℕ}
    (h : Solution a n) (hN : N = a ∨ N = a - 1 ∨ N = a - 2)
    (he : N = α * factors.prod) (hs : ∀ p ∈ factors, p.Prime ∧ Odd (N.factorization p)) :
    ¬ ((α : ℚ) * (n : ℚ) ^ factors.length + 2 ≤ ((n : ℚ) / 2) ^ exponent n) := sorry

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Finset

/-- There are at least eleven primes in `(n/2,n]` for every `n ≥ 101`. -/
theorem interval_card_ge_eleven {n : ℕ} (hn : 101 ≤ n) :
    11 ≤ (intervalPrimes n).card := sorry

end ThreeFactorials

end

@[expose] public section

namespace ThreeFactorials
open Finset

/-- Part (c) for n at least 101, including forms with primes outside the support of n!. -/
theorem theorem12c_large {a n N : ℕ} (h : Solution a n)
    (hN : N = a ∨ N = a - 1 ∨ N = a - 2) (hn : 101 ≤ n) : ¬ ForbiddenForm N := sorry

/-- The reviewed form of part (c), using Theorem 1.1. -/
theorem theorem12c_of_classification
    (classify : ∀ a n : ℕ, n ≤ 100 → Solution a n → (a, n) ∈ solutionsUpTo100)
    {a n N : ℕ} (h : Solution a n) (hN : N = a ∨ N = a - 1 ∨ N = a - 2)
    (form : ForbiddenForm N) : (a, n) ∈ solutionsUpTo100 := sorry

end ThreeFactorials

end

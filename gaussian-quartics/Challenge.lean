/-!
# The Diophantine equation x⁴ ± y⁴ = iz² in Gaussian integers: statements

The results of F. Najman, *The Diophantine equation x⁴ ± y⁴ = iz² in Gaussian integers*, Amer. Math. Monthly 117
(2010), 637–641 (arXiv:1005.1528). Generated by `scripts/make_challenge.py` from the library sources: the definitions
and instances that the statements use, copied verbatim, then the statements, with their proofs replaced by `sorry`.

* Theorem 1(i): `theorem1i`. Theorem 1(ii), with its converse: `theorem1ii`; all nontrivial solutions, primitive or
  not: `gaussian_int_plus_i_iff`.
* Theorem 2 (Hilbert): `theorem2_plus`, `theorem2_minus`.
* The closing remark (the same results over ℚ(i)): `rat_minus_i_trivial`, `rat_plus_i_iff`, `rat_hilbert_plus`,
  `rat_hilbert_minus`.
* The groups of ℚ(i)-points used in the proofs, points at infinity included: E(ℚ(i)) ≅ ℤ/2 × ℤ/2 for
  `Y² = X³ + X` and ℤ/2 × ℤ/4 for `Y² = X³ − X`. These are the definitions `plusPointGroup` and `minusPointGroup`,
  whose values (additive isomorphisms) the Solution supplies; their types are the statements.

Three instances are copied with their proofs: `Fact (¬ IsSquare (-1 : ℚ))`, from which Mathlib makes
`QuadraticAlgebra ℚ (-1) 0` a field, and `IsElliptic` (nonzero discriminant) for the two curves.
-/

@[expose] public section

namespace GaussianQuartics

/-- The Gaussian rationals, with generator satisfying `I² = -1`. -/
abbrev GaussianRat := QuadraticAlgebra ℚ (-1) 0

instance instFactNotIsSquareNegOne : Fact (¬ IsSquare (-1 : ℚ)) := ⟨by
  rintro ⟨q, hq⟩
  nlinarith [sq_nonneg q]⟩

/-- The imaginary unit in the Gaussian rationals. -/
def I : GaussianRat := QuadraticAlgebra.omega

end GaussianQuartics

end

@[expose] public section

namespace GaussianQuartics

/-- A solution is trivial when one of its coordinates is zero. -/
def Trivial {R : Type*} [Mul R] [Zero R] (x y z : R) : Prop :=
  x * y * z = 0

/-- The nontrivial solutions of the plus equation with imaginary coefficient,
written in terms of the freely chosen coordinate `y`. -/
def ScaledPlusSolution {R : Type*} [Ring R] (i x y z : R) : Prop :=
  (x = y ∨ x = -y ∨ x = i * y ∨ x = -(i * y)) ∧
    (z = i * (1 + i) * y ^ 2 ∨ z = -(i * (1 + i) * y ^ 2))

end GaussianQuartics

end

public section

namespace GaussianQuartics
open WeierstrassCurve.Affine

/-- The curve `Y² = X³ + X` over the Gaussian rationals. -/
@[expose] def plusCurve : WeierstrassCurve GaussianRat := ⟨0, 0, 0, 1, 0⟩

/-- The curve `Y² = X³ - X` over the Gaussian rationals. -/
@[expose] def minusCurve : WeierstrassCurve GaussianRat := ⟨0, 0, 0, -1, 0⟩

instance instIsEllipticPlusCurve : plusCurve.IsElliptic :=
  ⟨isUnit_iff_ne_zero.mpr (by decide +kernel)⟩

instance instIsEllipticMinusCurve : minusCurve.IsElliptic :=
  ⟨isUnit_iff_ne_zero.mpr (by decide +kernel)⟩

end GaussianQuartics

end

@[expose] public section

namespace GaussianQuartics

/-- The imaginary unit in mathlib's Gaussian integers. -/
def intI : GaussianInt := ⟨0, 1⟩

/-- Primitivity means that all common divisors of the three coordinates are units. -/
def Primitive (x y z : GaussianInt) : Prop :=
  ∀ d : GaussianInt, d ∣ x → d ∣ y → d ∣ z → IsUnit d

/-- The list of four Gaussian units. -/
def UnitChoice (x : GaussianInt) : Prop :=
  x = 1 ∨ x = -1 ∨ x = intI ∨ x = -intI

end GaussianQuartics

end

@[expose] public section

namespace GaussianQuartics

/-- Theorem 1(i) of the paper. -/
theorem theorem1i {x y z : GaussianInt} (h : x ^ 4 - y ^ 4 = intI * z ^ 2) :
    Trivial x y z := sorry

/-- Theorem 1(ii) of the paper, including the converse. -/
theorem theorem1ii {x y z : GaussianInt} :
    (¬ Trivial x y z ∧ Primitive x y z ∧ x ^ 4 + y ^ 4 = intI * z ^ 2) ↔
      UnitChoice x ∧ UnitChoice y ∧ (z = intI * (1 + intI) ∨ z = -(intI * (1 + intI))) := sorry

/-- Theorem 2 of the paper, plus sign. -/
theorem theorem2_plus {x y z : GaussianInt} (h : x ^ 4 + y ^ 4 = z ^ 2) :
    Trivial x y z := sorry

/-- Theorem 2 of the paper, minus sign. -/
theorem theorem2_minus {x y z : GaussianInt} (h : x ^ 4 - y ^ 4 = z ^ 2) :
    Trivial x y z := sorry

/-- The complete family of nontrivial solutions before imposing primitivity. -/
theorem gaussian_int_plus_i_iff {x y z : GaussianInt} (ht : ¬ Trivial x y z) :
    x ^ 4 + y ^ 4 = intI * z ^ 2 ↔ ScaledPlusSolution intI x y z := sorry

end GaussianQuartics

end

@[expose] public section

namespace GaussianQuartics

/-- Theorem 1(i) over the Gaussian rationals. -/
theorem rat_minus_i_trivial {x y z : GaussianRat} (h : x ^ 4 - y ^ 4 = I * z ^ 2) :
    Trivial x y z := sorry

/-- Theorem 1(ii) over the Gaussian rationals. -/
theorem rat_plus_i_iff {x y z : GaussianRat} (ht : ¬ Trivial x y z) :
    x ^ 4 + y ^ 4 = I * z ^ 2 ↔ ScaledPlusSolution I x y z := sorry

/-- Theorem 2, plus sign, over the Gaussian rationals. -/
theorem rat_hilbert_plus {x y z : GaussianRat} (h : x ^ 4 + y ^ 4 = z ^ 2) :
    Trivial x y z := sorry

/-- Theorem 2, minus sign, over the Gaussian rationals. -/
theorem rat_hilbert_minus {x y z : GaussianRat} (h : x ^ 4 - y ^ 4 = z ^ 2) :
    Trivial x y z := sorry

end GaussianQuartics

end

public section

namespace GaussianQuartics

/-- `E(ℚ(i)) ≃ ℤ/2 × ℤ/2` for `Y² = X³ + X`. -/
noncomputable def plusPointGroup : ZMod 2 × ZMod 2 ≃+ plusCurve.toAffine.Point := sorry

/-- `E(ℚ(i)) ≃ ℤ/2 × ℤ/4` for `Y² = X³ - X`. -/
noncomputable def minusPointGroup : ZMod 2 × ZMod 4 ≃+ minusCurve.toAffine.Point := sorry

end GaussianQuartics

end

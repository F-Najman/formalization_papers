def F (u v : P) : P :=
  (u^3+u^2-2*u-1)*(v*(v+1)) + (v^3+v^2-2*v-1)*(u*(u+1))

def A (u v : P) : P :=
  let s := (u+v)^2*(u+v+2)
  let d := s-2*u*v*(u+v+1)
  let t := (u-v)*(u+v)*(u+v+2)
  t^2+2*s*d-2*d^2

def B (u v : P) : P :=
  let s := (u+v)^2*(u+v+2)
  let d := s-2*u*v*(u+v+1)
  let t := (u-v)*(u+v)*(u+v+2)
  (-(t^2-d^2))*(d-s)^2

def D (u : P) : P :=
  u^14*(u+1)^14*(u^3+u^2-2*u-1)^2

def N (u : P) : P :=
  (u^2+u+1)^3 * (u^6+u^5+2*u^4+9*u^3+12*u^2+5*u+1) *
    (u^12+4*u^11+3*u^10-4*u^9+6*u^7-17*u^6-30*u^5+6*u^4+34*u^3+25*u^2+8*u+1)^3

def lhs (u v : P) : P := 256*(A u v ^ 2-3*B u v)^3*D u
def rhs (u v : P) : P := N u*(B u v ^ 2*(A u v ^ 2-4*B u v))

set_option maxHeartbeats 0 in
set_option maxRecDepth 16384 in
theorem checked_cofactor :
    let u := Coefficients.u
    let v := Coefficients.v
    (lhs u v).normal = (rhs u v + 256*u^6*cofactor*F u v).normal := by
  decide +kernel

end NajmanTrbovic.Cubic.MarkedCertificate

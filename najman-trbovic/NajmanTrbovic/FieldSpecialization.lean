module

public import NajmanTrbovic.QuadraticFields
public import NajmanTrbovic.NormObstruction

import Mathlib.Tactic

/-! The splitting results for quadratic fields generated by the affine models. -/

@[expose] public section

noncomputable section

namespace NajmanTrbovic

open QuadraticAlgebra

theorem map_form {R S : Type*} [Ring R] [Ring S] (f : R →+* S) (N : Level) (x y : R) :
    f (N.form x y) = N.form (f x) (f y) := by
  unfold Level.form
  rw [map_homogeneous, List.map_map]
  simp [Function.comp_def]

/-- A point with rational first coordinate and with second coordinate generating the field. -/
def FieldSpecialization (N : Level) (D : ℤ) : Prop :=
  ∃ (x : ℚ) (y : QuadraticField D), y.im ≠ 0 ∧
    y ^ 2 = N.form (algebraMap ℚ (QuadraticField D) x) 1

def sqrtD (D : ℤ) : QuadraticField D := if D % 4 = 1 then ⟨-1, 2⟩ else ⟨0, 1⟩

private theorem four_orderA_add_one (D : ℤ) (h : D % 4 = 1) : 4 * orderA D + 1 = D := by
  simp only [orderA, ite_eq_left h]
  omega

theorem sqrtD_sq (D : ℤ) : (sqrtD D) ^ 2 = algebraMap ℚ (QuadraticField D) (D : ℚ) := by
  by_cases h : D % 4 = 1
  · have he : 4 * (orderA D : ℚ) + 1 = (D : ℚ) := by
      exact_mod_cast four_orderA_add_one D h
    unfold sqrtD
    rw [ite_eq_left h]
    ext
    · simp [pow_two]
      linarith
    · norm_num [pow_two, orderB, h]
  · unfold sqrtD
    rw [ite_eq_right h]
    ext <;> norm_num [pow_two, orderA, orderB, h]

private theorem scalar_square_of_nonrational {D : ℤ} {y : QuadraticField D} (hy : y.im ≠ 0)
    {c : ℚ} (h : y ^ 2 = algebraMap ℚ (QuadraticField D) c) :
    ∃ s : ℚ, s ≠ 0 ∧ c = (D : ℚ) * s ^ 2 := by
  rw [pow_two] at h
  have hre := congrArg QuadraticAlgebra.re h
  have him := congrArg QuadraticAlgebra.im h
  change y.re * y.re + (orderA D : ℚ) * y.im * y.im = c at hre
  change y.re * y.im + y.im * y.re + (orderB D : ℚ) * y.im * y.im = 0 at him
  have ht : 2 * y.re + (orderB D : ℚ) * y.im = 0 := by
    apply (mul_eq_zero.mp (show (2 * y.re + (orderB D : ℚ)*y.im) * y.im = 0 by
      linear_combination him)).resolve_right hy
  by_cases h4 : D % 4 = 1
  · refine ⟨y.im / 2, div_ne_zero hy (by norm_num), ?_⟩
    have he : 4 * (orderA D : ℚ) + 1 = (D : ℚ) := by
      exact_mod_cast four_orderA_add_one D h4
    have hr : y.re = -y.im / 2 := by
      have ht' : 2 * y.re + y.im = 0 := by simpa [orderB, h4] using ht
      linarith
    rw [hr] at hre
    linear_combination -hre + (y.im / 2)^2 * he
  · refine ⟨y.im, hy, ?_⟩
    have hr : y.re = 0 := by
      have ht' : 2 * y.re = 0 := by simpa [orderB, h4] using ht
      linarith
    simpa [hr, orderA, h4, pow_two, mul_assoc] using hre.symm

theorem fieldSpecialization_iff_twist {N : Level} {D : ℤ} :
    FieldSpecialization N D ↔ RationalTwistPoint N D := by
  have hm (x : ℚ) : algebraMap ℚ (QuadraticField D) (N.form x 1) =
      N.form (algebraMap ℚ (QuadraticField D) x) 1 := by
    simpa only [map_one] using map_form (algebraMap ℚ (QuadraticField D)) N x 1
  constructor
  · rintro ⟨x, y, hy, h⟩
    rw [← hm] at h
    obtain ⟨s, hs, he⟩ := scalar_square_of_nonrational hy h
    exact ⟨x, s, hs, he⟩
  · rintro ⟨x, y, hy, h⟩
    refine ⟨x, y • sqrtD D, ?_, ?_⟩
    · rw [QuadraticAlgebra.im_smul]
      change y * (sqrtD D).im ≠ 0
      exact mul_ne_zero hy (by unfold sqrtD; split <;> norm_num)
    · rw [← hm, h, Algebra.smul_def, mul_pow, sqrtD_sq]
      simp only [map_mul, map_pow]
      ring

/-- Distinct squarefree radicands different from one give nonisomorphic quadratic fields. -/
theorem radicand_eq_of_isomorphic {D E : ℤ} (hd : Squarefree D) (hne : D ≠ 1) (he : Squarefree E)
    (f : QuadraticField D ≃ₐ[ℚ] QuadraticField E) : D = E := by
  let y := f (sqrtD D)
  have h : y ^ 2 = algebraMap ℚ (QuadraticField E) (D : ℚ) := by
    rw [show y ^ 2 = f ((sqrtD D)^2) by simp [y], sqrtD_sq, f.commutes]
  have hy : y.im ≠ 0 := by
    intro hn
    have hh := congrArg QuadraticAlgebra.re h
    simp [pow_two, hn] at hh
    exact radicand_not_square D hd hne ⟨y.re, hh.symm⟩
  obtain ⟨q, _, hq⟩ := scalar_square_of_nonrational hy h
  obtain ⟨s, hs⟩ := exists_int_of_mul_square_eq he hq.symm
  rw [← hs] at hq
  have hDe : D = E * s^2 := by exact_mod_cast hq
  have hu : IsUnit s := hd s ⟨E, by rw [hDe]; ring⟩
  rcases Int.isUnit_iff.mp hu with rfl | rfl <;> simpa using hDe

/-- The corrected Table 7 for number fields generated by the displayed affine models. -/
theorem table7_field_iff {N : Level} {p : ℕ} (hp : p.Prime) (h100 : p ≤ 100) :
    p ∈ N.table7 ↔ ∀ (D : ℤ) [Fact (Squarefree D)] [Fact (D ≠ 1)],
      FieldSpecialization N D →
      Algebra.IsUnramifiedIn (NumberField.RingOfIntegers (QuadraticField D))
        (Ideal.span ({(p : ℤ)} : Set ℤ)) := by
  rw [table7_iff_rational_twist hp h100]
  constructor
  · intro h D _ _ hD
    exact (unramified_iff_order hp).mp
      (h D Fact.out Fact.out (fieldSpecialization_iff_twist.mp hD))
  · intro h D hD hne ht
    let : Fact (Squarefree D) := ⟨hD⟩
    let : Fact (D ≠ 1) := ⟨hne⟩
    exact (unramified_iff_order hp).mpr (h D (fieldSpecialization_iff_twist.mpr ht))

/-- Theorem 2.8 for odd primes and fields generated by the displayed affine models. -/
theorem field_odd_ramified_imp_square (C : NormCase) {p : ℕ} (hp : p.Prime) (h₂ : p ≠ 2)
    {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)] (hD : FieldSpecialization C.level D)
    (hr : ¬ Algebra.IsUnramifiedIn (NumberField.RingOfIntegers (QuadraticField D))
      (Ideal.span ({(p : ℤ)} : Set ℤ))) : IsSquare (C.radicand : ZMod p) := by
  exact odd_ramified_imp_square C hp h₂
    (represents_iff_rational_twist.mpr ⟨Fact.out, Fact.out, fieldSpecialization_iff_twist.mp hD⟩)
    (fun h => hr ((unramified_iff_order hp).mp h))

/-- Theorem 2.8 for the explicit models. At 2, every residue is its own square. -/
theorem field_ramified_imp_square (C : NormCase) {p : ℕ} (hp : p.Prime)
    {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)] (hD : FieldSpecialization C.level D)
    (hr : ¬ Algebra.IsUnramifiedIn (NumberField.RingOfIntegers (QuadraticField D))
      (Ideal.span ({(p : ℤ)} : Set ℤ))) : IsSquare (C.radicand : ZMod p) := by
  by_cases h : p = 2
  · subst p
    have htwo : ∀ a : ZMod 2, a = a*a := by decide +kernel
    exact ⟨_, htwo _⟩
  · exact field_odd_ramified_imp_square C hp h hD hr

end NajmanTrbovic

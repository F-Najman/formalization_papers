module

public import NajmanTrbovic.QuadraticSplitting
public import NajmanTrbovic.Table2ModFive
public import NajmanTrbovic.SmallPrimeSplitting

import Mathlib.Tactic

/-! The assertions of Table 2 for fields generated by the explicit affine models. -/

@[expose] public section

namespace NajmanTrbovic

def Level.table2Split : Level → List ℕ
  | .n28 => [3]
  | .n30 => [2, 3]
  | .n33 => [2]
  | .n35 => [7]
  | .n39 => [13]
  | .n40 => [2, 3, 5]
  | .n46 => [2]
  | .n48 => [2, 3, 5]
  | _ => []

def Level.table2Unramified : Level → List ℕ
  | .n28 => [3]
  | .n30 => [2, 3]
  | .n33 => [2]
  | .n35 => [2, 7]
  | .n39 => [2, 13]
  | .n40 => [2, 3, 5]
  | .n46 => [2]
  | .n48 => [2, 3, 5]
  | _ => []

def Level.table2NotInert : Level → List ℕ
  | .n22 => [2]
  | .n26 => [13]
  | .n28 => [3, 7]
  | .n29 => [29]
  | .n30 => [2, 3, 5]
  | .n33 => [2, 11]
  | .n35 => [5, 7]
  | .n39 => [3, 13]
  | .n40 => [2, 3, 5]
  | .n41 => [41]
  | .n46 => [2]
  | .n48 => [2]
  | .n50 => [5]
  | _ => []

def Level.table2Odd (N : Level) : Prop := N ∈ [.n26, .n29, .n30, .n33, .n35, .n39, .n40, .n46, .n48, .n50]

def Level.table2Real (N : Level) : Prop := N ∈ [.n28, .n33, .n40, .n48]

private theorem split_odd (C : OddSplitCase) {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)]
    (hD : FieldSpecialization C.level D) : SplitsAt D C.prime := by
  have hp : C.prime.Prime := by cases C <;> decide
  have h₂ : C.prime ≠ 2 := by cases C <;> decide
  obtain ⟨h₀, hs⟩ := table2_odd_split_residue C hD Fact.out Fact.out
  exact splits_odd_of_residue hp h₂ h₀ hs

private theorem rep {N : Level} {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)]
    (hD : FieldSpecialization N D) : Represents N D :=
  represents_iff_rational_twist.mpr ⟨Fact.out, Fact.out, fieldSpecialization_iff_twist.mp hD⟩

theorem table2_split {N : Level} {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)]
    (hD : FieldSpecialization N D) {p : ℕ} (hp : p ∈ N.table2Split) : SplitsAt D p := by
  cases N <;> simp only [Level.table2Split, List.mem_cons, List.not_mem_nil, or_false] at hp
  case n28 =>
    subst p
    exact split_odd .n28p3 hD
  case n30 =>
    rcases hp with rfl | rfl
    · exact splits_two_of_residue (table2_two .n30 (rep hD))
    · exact split_odd .n30p3 hD
  case n33 =>
    subst p
    exact splits_two_of_residue (table2_two .n33 (rep hD))
  case n35 =>
    subst p
    exact split_odd .n35p7 hD
  case n39 =>
    subst p
    exact split_odd .n39p13 hD
  case n40 =>
    rcases hp with rfl | rfl | rfl
    · exact splits_two_of_residue (table2_two .n40 (rep hD))
    · exact split_odd .n40p3 hD
    · exact split_odd .n40p5 hD
  case n46 =>
    subst p
    exact splits_two_of_residue (table2_two .n46 (rep hD))
  case n48 =>
    rcases hp with rfl | rfl | rfl
    · exact splits_two_of_residue (table2_two .n48 (rep hD))
    · exact split_odd .n48p3 hD
    · exact split_odd .n48p5 hD

theorem table2_not_inert {N : Level} {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)]
    (hD : FieldSpecialization N D) {p : ℕ} (hp : p ∈ N.table2NotInert) : ¬InertAt D p := by
  cases N <;> simp only [Level.table2NotInert, List.mem_cons, List.not_mem_nil, or_false] at hp
  case n22 =>
    subst p
    exact not_inert_two_of_residue (table2_two .n22 (rep hD))
  case n26 =>
    subst p
    exact not_inert_odd_of_residue (p := 13) (by decide) (by decide)
        (table2_odd_local_not_inert .n26p13 (rep hD))
  case n28 =>
    rcases hp with rfl | rfl
    · exact not_inert_of_split (p := 3) (by decide) (table2_split hD (by decide))
    · exact not_inert_odd_of_residue (p := 7) (by decide) (by decide)
        (table2_odd_local_not_inert .n28p7 (rep hD))
  case n29 =>
    subst p
    exact not_inert_odd_of_residue (p := 29) (by decide) (by decide)
        (table2_reciprocity_not_inert .n29 (rep hD))
  case n30 =>
    rcases hp with rfl | rfl | rfl
    · exact not_inert_of_split (p := 2) (by decide) (table2_split hD (by decide))
    · exact not_inert_of_split (p := 3) (by decide) (table2_split hD (by decide))
    · exact not_inert_odd_of_residue (p := 5) (by decide) (by decide)
        (table2_odd_local_not_inert .n30p5 (rep hD))
  case n33 =>
    rcases hp with rfl | rfl
    · exact not_inert_of_split (p := 2) (by decide) (table2_split hD (by decide))
    · exact not_inert_odd_of_residue (p := 11) (by decide) (by decide)
        (table2_reciprocity_not_inert .n33 (rep hD))
  case n35 =>
    rcases hp with rfl | rfl
    · exact not_inert_odd_of_residue (p := 5) (by decide) (by decide)
        (table2_odd_local_not_inert .n35p5 (rep hD))
    · exact not_inert_of_split (p := 7) (by decide) (table2_split hD (by decide))
  case n39 =>
    rcases hp with rfl | rfl
    · exact not_inert_odd_of_residue (p := 3) (by decide) (by decide)
        (table2_odd_local_not_inert .n39p3 (rep hD))
    · exact not_inert_of_split (p := 13) (by decide) (table2_split hD (by decide))
  case n40 =>
    rcases hp with rfl | rfl | rfl
    · exact not_inert_of_split (p := 2) (by decide) (table2_split hD (by decide))
    · exact not_inert_of_split (p := 3) (by decide) (table2_split hD (by decide))
    · exact not_inert_of_split (p := 5) (by decide) (table2_split hD (by decide))
  case n41 =>
    subst p
    exact not_inert_odd_of_residue (p := 41) (by decide) (by decide)
        (table2_reciprocity_not_inert .n41 (rep hD))
  case n46 =>
    subst p
    exact not_inert_of_split (p := 2) (by decide) (table2_split hD (by decide))
  case n48 =>
    subst p
    exact not_inert_of_split (p := 2) (by decide) (table2_split hD (by decide))
  case n50 =>
    subst p
    exact not_inert_odd_of_residue (p := 5) (by decide) (by decide)
        (table2_odd_local_not_inert .n50p5 (rep hD))

private theorem checked_unramified (N : Level) :
    ∀ p ∈ N.table2Unramified, p.Prime ∧ p ≤ 100 ∧ p ∈ N.table7 := by
  cases N <;> simp only [Level.table2Unramified, List.forall_mem_cons, List.not_mem_nil,
    IsEmpty.forall_iff, implies_true, and_true] <;> decide +kernel

theorem table2_unramified {N : Level} {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)]
    (hD : FieldSpecialization N D) {p : ℕ} (hp : p ∈ N.table2Unramified) :
    Algebra.IsUnramifiedIn (NumberField.RingOfIntegers (QuadraticField D))
      (Ideal.span ({(p : ℤ)} : Set ℤ)) := by
  obtain ⟨h, h100, ht⟩ := checked_unramified N p hp
  exact (table7_field_iff h h100).mp ht D hD

theorem table2_odd_radicand {N : Level} {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)]
    (hD : FieldSpecialization N D) (h : N.table2Odd) : D%2=1 := by
  simp only [Level.table2Odd, List.mem_cons, List.not_mem_nil, or_false] at h
  rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact table2_two .n26 (rep hD)
  · exact table2_two .n29 (rep hD)
  · have hn := table2_two .n30 (rep hD)
    change D%8=1 at hn
    omega
  · have hn := table2_two .n33 (rep hD)
    change D%8=1 at hn
    omega
  · exact table2_two .n35 (rep hD)
  · exact table2_two .n39 (rep hD)
  · have hn := table2_two .n40 (rep hD)
    change D%8=1 at hn
    omega
  · have hn := table2_two .n46 (rep hD)
    change D%8=1 at hn
    omega
  · have hn := table2_two .n48 (rep hD)
    change D%8=1 at hn
    omega
  · exact table2_two .n50 (rep hD)

theorem table2_real {N : Level} {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)]
    (hD : FieldSpecialization N D) (h : N.table2Real) : 0 < D := by
  apply real_radicand_of_specialization _ Fact.out hD
  simpa [Level.table2Real] using h

/-- The three refined residue claims marked by asterisks in Table 2. -/
theorem table2_refinements {D : ℤ} [Fact (Squarefree D)] [Fact (D ≠ 1)] :
    (FieldSpecialization .n22 D → D%8=1 ∨ D%8=2 ∨ D%8=6) ∧
    (FieldSpecialization .n30 D → D%5=0 ∨ D%5=1) ∧
    (FieldSpecialization .n35 D → D%5=0 ∨ D%5=1) :=
  ⟨fun h => table2_two .n22 (rep h), fun h => table2_mod_five .n30 (rep h),
    fun h => table2_mod_five .n35 (rep h)⟩

end NajmanTrbovic
